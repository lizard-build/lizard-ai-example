TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Defaults to the owner's private chat. Use a supergroup ID for a forum group.
TELEGRAM_CHAT_ID=
DATABASE_URL=
LIZARD_API_KEY=
LIZARD_PROJECT_ID=
LIZARD_API_URL=https://lizard.build
LIZARD_VOLUME_NAME=codex-personal
LIZARD_VOLUME_SIZE_GB=10
LIZARD_TEMPLATE=codex
# Set only for API authentication; otherwise use /login in the private chat.
OPENAI_API_KEY=
# Worker only: voice transcription via OpenRouter. Never pass this to user Sandboxes.
OPENROUTER_API_KEY=
# Optional: omitted means the Codex account's default model.
CODEX_MODEL=
PORT=3000
# all = one gateway plus worker; split roles into separate services when scaling.
BOT_ROLE=all
SANDBOX_IDLE_MINUTES=30
SANDBOX_LEASE_MINUTES=120
MAX_ACTIVE_SANDBOXES=10
WORKER_SLOTS=10
MAX_APPROVED_USERS=100
TENANT_VOLUME_SIZE_GB=2
MAX_SESSIONS_PER_USER=20
MAX_QUEUED_PER_USER=20
MAX_ACTIVE_TURNS_PER_USER=2
USER_MESSAGES_PER_MINUTE=20
MAX_TASK_MINUTES=240
APPROVAL_WAIT_MINUTES=60

# Worker only: automatic scoped CLI credentials for approved Telegram users.
# Enable after migrating existing volumes with scripts/migrate-tenant.mjs.
LIZARD_MANAGED_ACCOUNTS=false
# Creates isolated compute workspaces even when automatic CLI credentials are off.
LIZARD_PROVISIONER_KEY=
# Stable, random 32 bytes encoded as base64; keep it across worker restarts.
TENANT_CREDENTIAL_KEY=
